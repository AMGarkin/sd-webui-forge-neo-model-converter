        "av_ca_video_scale_shift_adaln_single",
        "patchify_proj",
        "proj_out",
        "prompt_adaln_single",
        "transformer_blocks.0.",
        "transformer_blocks.1.",
        "transformer_blocks.46.",
        "transformer_blocks.47.",
        "video_embeddings_connector",
        "vae.decoder",
        "vae.encoder",
        "vocoder",
        "to_gate_logits"
      ]
    }
