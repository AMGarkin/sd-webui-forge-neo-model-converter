  "filters": {
    "gemma4": {
      "help": "Gemma4 text/multimodal model: skip audio, per_layer_input_gate, per_layer_projection, vision, multi_modal_projector",
      "category": "text",
      "exclude": [
        "audio",
        "per_layer_input_gate",
        "per_layer_projection",
        "vision",
        "multi_modal_projector"
      ]
    },
    "qwen_vlm": {
      "help": "Qwen VLM family: skip first/last language layers, embeddings, MTP, and the full visual encoder",
      "category": "text",
      "exclude": [
        ".layers.0.",
        "lm_head",
        "embed_tokens",
        "in_proj_a",
        "in_proj_b",
        "visual.",
        "mtp."
      ],
      "exclude_final_language_layer": true,
      "preserve_dtype": {
        "bfloat16": [
          ".*"
        ]
      }
    },
    "qwen35": {
      "help": "Compatibility alias for --qwen_vlm",
      "category": "text",
      "alias_for": "qwen_vlm"
    },
    "t5xxl": {
      "help": "T5-XXL text encoder: skip norms/biases, remove decoder layers",
      "category": "text",
      "exclude": [
        "norm",
        "bias",
        "embed_tokens",
        "lm_head",
        "shared",
        "patch_embedding",
        "audio_model.patch_embedding",
        "ref_conv",
        "control_adapter",
        "motion_encoder.enc.net_app",
        "face_encoder.conv",
        "pose_patch_embedding",
