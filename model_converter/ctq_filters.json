        "img_emb.proj",
        "k_norm",
        "q_norm",
        "motion_encoder.dec",
        "head.modulation",
        "casual_audio_encoder",
        "cond_encoder",
        "frame_packer",
        "norm_k",
        "norm_q",
        "tekken_model",
        "multi_modal_projector",
        "patch_conv",
        "ln_pre",
        "input_layernorm",
        "attention_norm",
        "post_attention_layernorm",
        "mm_input_projection_weight"
      ],
      "remove": [
        "decoder",
        "lm_head"
      ]
    },
    "mistral": {
      "help": "Mistral text encoder exclusions",
      "category": "text",
      "exclude": [
        "norm",
        "bias",
        "embed_tokens",
        "lm_head",
        "shared",
        "patch_embedding",
        "audio_model.patch_embedding",
        "ref_conv",
        "control_adapter",
        "motion_encoder.enc.net_app",
        "face_encoder.conv",
        "pose_patch_embedding",
        "motion_encoder.enc.fc",
        "img_emb.proj",
        "k_norm",
        "q_norm",
        "motion_encoder.dec",
        "head.modulation",
        "casual_audio_encoder",
        "cond_encoder",
        "frame_packer",
        "norm_k",
        "norm_q",
        "tekken_model",
        "multi_modal_projector",
        "patch_conv",
        "ln_pre",
        "input_layernorm",
        "attention_norm",
        "post_attention_layernorm",
        "mm_input_projection_weight"
      ]
    },
    "visual": {
      "help": "Visual encoder: skip MLP layers (down/up/gate proj)",
      "category": "text",
      "exclude": [
        "mlp.down_proj",
        "mlp.up_proj",
        "mlp.gate_proj"
      ]
    },
    "generic_text": {
      "help": "Generic text encoder: skip MLP layers (down/up/gate proj)",
      "category": "text"
    },
    "anima": {
      "help": "Anima diffusion model: keep first blocks, adaln_modulation, final/embedding layers high-precision",
      "category": "diffusion",
      "highprec": [
        "net.blocks.0.",
        "net.blocks.1.adaln_modulation",
        "final_layer",
        "llm_adapter",
        "t_embedder",
        "x_embedder"
      ]
    },
    "lens": {
      "help": "LENS diffusion model: keep time_text_embed, img_in, norm_out, proj_out, some mod layers high-precision",
      "category": "diffusion",
      "highprec": [
        "time_text_embed",
        "img_in",
        "norm_out",
        "proj_out",
        "img_mod.1",
        "txt_mod.1",
        "txt_in"
      ]
    },
    "flux2": {
      "help": "Flux.2: keep modulation/guidance/time/final layers high-precision",
      "category": "diffusion",
      "highprec": [
        "stream_modulation",
        "guidance_in",
        "time_in",
        "final_layer",
        "img_in",
        "txt_in"
      ]
    },
    "distillation_large": {
      "help": "Chroma/distilled (large): keep distilled_guidance, final, img/txt_in high-precision",
      "category": "diffusion",
      "highprec": [
        "distilled_guidance_layer",
        "final_layer",
        "img_in",
        "txt_in"
      ]
    },
    "distillation_small": {
      "help": "Chroma/distilled (small): keep only distilled_guidance high-precision",
      "category": "diffusion",
      "highprec": [
        "distilled_guidance_layer"
      ]
    },
    "nerf_large": {
      "help": "NeRF (large): keep nerf_blocks, distilled_guidance, txt_in high-precision",
      "category": "diffusion",
      "highprec": [
        "distilled_guidance_layer",
        "nerf_blocks",
        "nerf_image_embedder",
        "txt_in",
        "_attn.proj"
      ]
    },
    "nerf_small": {
      "help": "NeRF (small): keep nerf_blocks, distilled_guidance high-precision",
      "category": "diffusion",
      "highprec": [
        "distilled_guidance_layer",
        "nerf_blocks",
        "nerf_image_embedder"
      ]
    },
    "radiance": {
      "help": "Radiance model: keep img_in_patch, nerf_final_layer high-precision",
      "category": "diffusion",
      "highprec": [
        "img_in_patch",
        "nerf_final_layer_conv",
        "__x0__"
      ]
    },
    "krea2": {
      "help": "Krea2: keep firs, las, tml, txtfusion, last.modulation, tpro layers high-precision",
      "category": "diffusion",
      "highprec": [
        "firs",
        "las",
        "tml",
        "txtfusion",
        "last.modulatio",
        "tpro"
      ],
      "preserve_dtype": {
        "float32": [
          "(?:^|\\.)(?:first|last\\.linear|tmlp\\.(?:0|2)|tproj\\.1|txtfusion\\.projector|txtmlp\\.(?:1|3))\\.weight$"
        ]
      }
    },
    "ideogram4": {
      "help": "Ideogram4: keep embed_image_indicator, t_embedding, adaln_proj, final_layer, input_proj layers high-precision",
      "category": "diffusion",
      "highprec": [
        "embed_image_indicator",
        "t_embedding",
        "llm_cond_proj",
        "adaln_proj",
        "final_layer",
        "input_proj"
      ]
    },
    "wan": {
      "help": "WAN video model: skip embeddings, encoders, head",
      "category": "video",
      "exclude": [
        "norm",
        "bias",
        "embed_tokens",
        "lm_head",
        "shared",
        "patch_embedding",
